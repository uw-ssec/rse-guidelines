{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            // Referenced by the "Python: GenDate" launch configuration as its
            // preLaunchTask. Deletes the output file so gendate.py takes the
            // "generate" branch instead of the "file exists" early return.
            //
            // Runs Python rather than `rm -f` so the task works on Windows too.
            // ${command:python.interpreterPath} resolves to the interpreter you
            // selected with "Python: Select Interpreter".
            "label": "delete_today",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-c",
                "import pathlib; pathlib.Path('today.json').unlink(missing_ok=True)"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ]
}
